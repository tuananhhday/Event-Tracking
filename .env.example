AI_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=
OPENROUTER_MODEL_SPEC=auto
OPENROUTER_MODEL_EXPLAIN=auto
OPENROUTER_ROUTING=free-first
OPENROUTER_ALLOW_PAID=true
OPENROUTER_MAX_PROMPT_USD_PER_MILLION=0.25
OPENROUTER_MAX_COMPLETION_USD_PER_MILLION=1
OPENROUTER_MAX_MODEL_ATTEMPTS=6
OPENROUTER_MAX_FREE_ATTEMPTS=2
OPENROUTER_MAX_OUTPUT_TOKENS=1800
OPENROUTER_REQUEST_BUDGET_USD=0.01
AI_TIMEOUT_SEC=30
AI_MAX_RETRIES=2
# Optional corporate network settings: use values supplied by your IT team.
# HTTPS_PROXY=http://proxy.company.example:8080
# HTTP_PROXY=http://proxy.company.example:8080
# NODE_EXTRA_CA_CERTS=C:/CompanyCA/root-ca.pem
# Local app/CDP addresses are excluded from the proxy by scripts/start-ai.mjs.
