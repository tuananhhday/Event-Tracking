AI_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=
OPENROUTER_MODEL_SPEC=auto
OPENROUTER_MODEL_EXPLAIN=auto
# Model cho Luồng tự động (AI chạy thử / tự sửa): danh sách thử theo thứ tự, "auto" ở cuối để thử model khác.
# Để trống = deepseek/deepseek-v4-flash,qwen/qwen3.5-flash-02-23,openai/gpt-4o-mini,mistralai/mistral-small-3.2-24b-instruct,openai/gpt-4.1-nano,auto
OPENROUTER_MODEL_AUTOMATION=
OPENROUTER_ROUTING=free-first
OPENROUTER_ALLOW_PAID=true
OPENROUTER_MAX_PROMPT_USD_PER_MILLION=0.25
OPENROUTER_MAX_COMPLETION_USD_PER_MILLION=1
OPENROUTER_MAX_MODEL_ATTEMPTS=6
OPENROUTER_MAX_FREE_ATTEMPTS=2
OPENROUTER_MAX_OUTPUT_TOKENS=1800
OPENROUTER_REQUEST_BUDGET_USD=0.01
AI_TIMEOUT_SEC=30
AI_MAX_RETRIES=2
